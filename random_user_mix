class item_seq_random_user_sequence_mix extends uvm_sequence #(item_transaction);
  `uvm_object_utils(item_seq_random_user_sequence_mix)

  function new(string name = "item_seq_random_user_sequence_mix");
    super.new(name);
  endfunction

  task body();
   item_transaction item_req;
    repeat(2) begin
      item_req = item_transaction::type_id::create("item_req");
      start_item(item_req);
      assert(item_req.randomize() with { item_select inside { [12: 32] }; item_select_valid == 1;});
      finish_item(item_req);
      #100;
    end
  endtask
endclass

class currency_seq_random_user_sequence_mix extends uvm_sequence #(currency_transaction);
  `uvm_object_utils(currency_seq_random_user_sequence_mix)

  function new(string name = "currency_seq_random_user_sequence_mix");
    super.new(name);
  endfunction

  task body();
  currency_transaction c_tx; 
    
    repeat(2) begin
    c_tx = currency_transaction::type_id::create("c_tx");
    start_item(c_tx);
      assert(c_tx.randomize() with { currency_value inside {2,500,50}; currency_valid == 1; });
    finish_item(c_tx);
    #100;
  end
  endtask
endclass
