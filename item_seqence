class item_sequence extends uvm_sequence #(item_transaction);
  `uvm_object_utils(item_sequence)
  

  function new(string name = "item_sequence");
    super.new(name);
  endfunction
  task body();
    item_transaction req = item_transaction::type_id::create("req");
    req.item_select = 16'd15;
    req.item_select_valid = 1;
    start_item(req);
    finish_item(req);
  endtask
endclass

