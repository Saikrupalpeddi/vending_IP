class item_agent extends uvm_agent;
  item_sequencer seqr;
  item_driver    drvr;
  item_monitor   mon;

  `uvm_component_utils(item_agent)

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    seqr = item_sequencer::type_id::create("seqr", this);
    drvr = item_driver::type_id::create("drvr", this);
    mon  = item_monitor::type_id::create("mon", this);
  endfunction

  function void connect_phase(uvm_phase phase);
    drvr.seq_item_port.connect(seqr.seq_item_export);
  endfunc
