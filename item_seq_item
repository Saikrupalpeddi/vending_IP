class item_seq_item extends uvm_sequence_item;

  rand bit        item_select_valid;
  rand bit [9:0]  item_select;

  `uvm_object_utils(item_seq_item)

  function new(string name = "item_seq_item");
    super.new(name);
    item_select_valid = 1'b0;
    item_select       = 10'd0;
  endfunction

  function string convert2string();
    return $sformatf("item_select_valid = %0b, item_select = %0d", item_select_valid, item_select);
  endfunction

endclass
