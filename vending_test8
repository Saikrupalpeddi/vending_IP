class config_negative_test extends uvm_test;
  `uvm_component_utils(config_negative_test)

  vending_env env;
  virtual ctrl_if vif;
  config_invalid_address_seq bad_addr_seq;
  config_while_mode_select_seq bad_time_seq;

  function new(string name = "config_negative_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    env = vending_env::type_id::create("env", this);
      if (!uvm_config_db#(virtual ctrl_if)::get(this, "", "ctrl_vif", vif))
        `uvm_fatal("test8", "Virtual interface not found")
  endfunction

  function void end_of_elaboration_phase(uvm_phase phase);
    uvm_top.print_topology();
  endfunction

  task run_phase(uvm_phase phase);
   phase.raise_objection(this);
     
	vif.cfg_mode = 1;
    `uvm_info("CFG_NEG_TEST","Configuration invalid test is started",UVM_LOW)
    bad_addr_seq = config_invalid_address_seq::type_id::create("bad_addr_seq");
    bad_addr_seq.start(env.cfg_ag.seqr);
    `uvm_info("CFG_NEG_TEST", "Invalid address config sequence completed", UVM_LOW)
    
    `uvm_info("CFG_NEG_TEST","Configuration user mode test is started",UVM_LOW)
    
    vif.cfg_mode = 0;
  

    #50;
    
    
    bad_time_seq = config_while_mode_select_seq::type_id::create("bad_time_seq");
    bad_time_seq.start(env.cfg_ag.seqr);
    `uvm_info("CFG_NEG_TEST", "Config during user mode sequence completed", UVM_LOW)

    phase.drop_objection(this);
  endtask
endclass
