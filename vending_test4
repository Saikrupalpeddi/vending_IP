class error_operation_test extends uvm_test;
  `uvm_component_utils(error_operation_test)

  vending_env env;
   cfg_sequence cfg_seq;
  virtual ctrl_if vif;
  virtual dispense_if d_vif;
  
   currency_before_item_seq out_curr_seq;
   item_after_currency_seq late_item_seq;
    unsupported_currency_sequence bad_curr_seq;
    invalid_item_select_sequence inv_item_seq;
  
  item_sequence item_s;
    
  
   
  

  function new(string name = "error_operation_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction
  
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    env = vending_env::type_id::create("env", this);
    if (!uvm_config_db#(virtual ctrl_if)::get(this, "", "ctrl_vif", vif))
      `uvm_fatal("CFG_DRIVER", "Virtual interface not found")
  endfunction
      
      function void end_of_elaboration_phase (uvm_phase phase);
uvm_top.print_topology ();
endfunction
  
  task run_phase(uvm_phase phase);
     phase.raise_objection(this);
    
    vif.cfg_mode = 1'b1;
    
    `uvm_info("Vending_test", "Configuration of inventory started",UVM_LOW)
    cfg_seq = cfg_sequence::type_id::create("cfg_seq");
    cfg_seq.start(env.cfg_ag.seqr);
    #10; 
    vif.cfg_mode = 1'b0;
    #10;
    
    
    
    `uvm_info("VENDING_TEST", "UNSUPPORTED CURRENCY INSERTION TEST",UVM_LOW)
    item_s = item_sequence::type_id::create("item_s");
    item_s.start(env.item_ag.seqr);
    #10;
     bad_curr_seq = unsupported_currency_sequence::type_id::create("bad_curr_seq");
    bad_curr_seq.start(env.currency_ag.seqr);
    #100;
    
    `uvm_info("VENDING_TEST", " CURRENCY-1ST-ITEM NEXT TEST",UVM_LOW)
     out_curr_seq = currency_before_item_seq::type_id::create("out_curr_seq");
    out_curr_seq.start(env.currency_ag.seqr);
    #10;
    
    late_item_seq = item_after_currency_seq::type_id::create("late_item_seq");
    late_item_seq.start(env.item_ag.seqr);
     #100;
    
  `uvm_info("VENDING_TEST","INAVLID ITEM SELECT",UVM_LOW)
    inv_item_seq = invalid_item_select_sequence::type_id::create("inv_item_seq");
    inv_item_seq.start(env.item_ag.seqr);
    #10;
    `uvm_info("ERROR_TEST", "All currency_before_item_seq error operation sequences completed", UVM_LOW);
    phase.drop_objection(this);
  endtask
endclass
