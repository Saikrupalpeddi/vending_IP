  `uvm_component_utils(operation_random_test)

  vending_env env;
    cfg_sequence cfg_seq;
  virtual ctrl_if vif;
  
  
    item_seq_random_valid_multiitem item_seq_hdl;
  currency_seq_random_valid_multiitem currency_seq_hdl;
  
    item_seq_random_user_sequence_mix i_user;
  currency_seq_random_user_sequence_mix c_user;
  
    item_seq_randomized_back_to_back_operations i_b2b;
  currency_seq_randomized_back_to_back_operations c_b2b;


 

  function new(string name = "operation_random_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    env = vending_env::type_id::create("env", this);
              if (!uvm_config_db#(virtual ctrl_if)::get(this, "", "ctrl_vif", vif))
                `uvm_fatal("test6", "Virtual interface not found")
  endfunction

  function void end_of_elaboration_phase(uvm_phase phase);
    uvm_top.print_topology();
  endfunction

  task run_phase(uvm_phase phase);
     phase.raise_objection(this);

    `uvm_info("OP_RANDOM_TEST", "Starting randomized operational sequences...", UVM_LOW)
    vif.cfg_mode = 1;

     cfg_seq = cfg_sequence::type_id::create("cfg_seq");
    cfg_seq.start(env.cfg_ag.seqr);
    `uvm_info("LATENCY_TEST", "Configuration sequence completed.", UVM_LOW)
    vif.cfg_mode = 0;

    #100;
    // Random Valid Multi-Item Sequence
  
  fork
   
      item_seq_hdl = item_seq_random_valid_multiitem::type_id::create("item_seq_hdl");
    item_seq_hdl.start(env.item_ag.seqr); 
   
    
    begin
    #10;
      currency_seq_hdl = currency_seq_random_valid_multiitem::type_id::create("currency_seq_hdl");
      currency_seq_hdl.start(env.currency_ag.seqr);
    end
  join

    `uvm_info("RAND_MULTIITEM_TEST", "Both item & currency random sequences done.",UVM_MEDIUM)
    
    #50;
 
    // Random Mixed User Sequence
    
  fork
      i_user = item_seq_random_user_sequence_mix::type_id::create("i_user");
    i_user.start(env.item_ag.seqr);
    begin 
      #10;
    c_user = currency_seq_random_user_sequence_mix::type_id::create("c_user");
    c_user.start(env.currency_ag.seqr);
    end
  join

    `uvm_info("USER_MIX_TEST", "Random user mix sequences completed.",UVM_LOW);
    #50;

    // BACK 2 BACK TRANSACTIONS

  fork
    i_b2b = item_seq_randomized_back_to_back_operations::type_id::create("i_b2b");
    i_b2b.start(env.item_ag.seqr);
    begin
    #10;
    c_b2b = currency_seq_randomized_back_to_back_operations::type_id::create("c_b2b");
    c_b2b.start(env.currency_ag.seqr);
    end
  join
  

    `uvm_info("BACK2BACK_OPS_TEST", "Back-to-back operations done.",UVM_LOW);
    #50;

    phase.drop_objection(this);
    
  endtask
endclass
