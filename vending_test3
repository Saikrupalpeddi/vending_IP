class config_mode_test extends uvm_test;
  `uvm_component_utils(config_mode_test)

  
  virtual ctrl_if vif;
  virtual cfg_if cfg_vif;
  
  cfg_sequence base_cfg_seq;
  config_write_sequence cfg_wr_seq;
  config_read_sequence cfg_rd_seq;
  config_total_item_sequence cfg_total_seq;
  vending_env env;

  function new(string name = "config_mode_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void end_of_elaboration_phase(uvm_phase phase);
    uvm_top.print_topology();
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    env = vending_env::type_id::create("env", this);
             if (!uvm_config_db#(virtual ctrl_if)::get(this, "", "ctrl_vif", vif))
               `uvm_fatal("test3", "Virtual interface not found")
           if (!uvm_config_db#(virtual cfg_if)::get(this, "", "cfg_vif", cfg_vif))
             `uvm_fatal("test3", "Virtual interface not found")
  endfunction
             
    task run_phase(uvm_phase phase);
     phase.raise_objection(this);

    #20; vif.cfg_mode=1'b1;
    
//     base_cfg_seq = cfg_sequence::type_id::create("base_cfg_seq");
//     base_cfg_seq.start(env.cfg_ag.seqr);
    
    
    cfg_wr_seq = config_write_sequence::type_id::create("cfg_wr_seq");
    cfg_wr_seq.start(env.cfg_ag.seqr);
    vif.cfg_mode=1'b0;
    #200;
    vif.cfg_mode=1'b1;
    cfg_rd_seq = config_read_sequence::type_id::create("cfg_rd_seq");
    cfg_rd_seq.start(env.cfg_ag.seqr);
    #20;
    cfg_total_seq = config_total_item_sequence::type_id::create("cfg_total_seq");
    cfg_total_seq.start(env.cfg_ag.seqr);
    #20;
 phase.drop_objection(this);
  endtask
endclass
